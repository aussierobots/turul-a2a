# macOS
.DS_Store

# Claude — local state and settings are ignored, but project-shared
# subagents are tracked so the spec-compliance agent is available to everyone.
.claude/*
!.claude/agents/

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local environment overrides (per-developer config; `.env.example` is committed)
.env
.env.local
.env.*.local

# Python — virtualenvs and bytecode caches in example client dirs
.venv/
**/__pycache__/
*.pyc

# Go — built binaries from example clients. Each `go build ./...` in a per-agent
# `go/` directory drops a `probe` binary; ignore them globally rather than
# enumerating each path.
/examples/clients/go/probe
/examples/interop-clients/*/go/probe

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
