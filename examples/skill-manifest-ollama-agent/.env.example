# Copy this file to `.env` (in this directory) and edit values for your local
# setup. `.env` is gitignored; this `.env.example` is committed as
# documentation.
#
# The binary auto-loads `.env` from the current working directory via
# `dotenvy::dotenv()` at startup. Tests do NOT load `.env` and stay hermetic.

# ── Ollama live mode ────────────────────────────────────────────────────────
# Default: OFFLINE. The handler returns a deterministic stub artifact.
# Live mode: set OLLAMA_BASE_URL to your reachable Ollama server.

# Default to a local Ollama:
OLLAMA_BASE_URL=http://localhost:11434

# If you run Ollama on a LAN host (mDNS / /etc/hosts), point at it instead:
# OLLAMA_BASE_URL=http://<your-ollama-host>:11434

# Alternative live-mode toggle that defaults to http://localhost:11434 if
# OLLAMA_BASE_URL is unset. Either var being set flips the handler to live.
# RUN_OLLAMA_SMOKE=1

# ── Server bind port ─────────────────────────────────────────────────────────
# Default: 3000. Change if 3000 is in use (e.g. by echo-agent).
# A2A_PORT=3010
